---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Uniquefacturing | UFAC"
  description="Uniquefacturing (UFAC) — an R&D partner that raises your technical edge. Prototype Studio."
>
  <section class="hero">
    <div class="container">
      <img class="hero-mark" src="/images/LOGO.png" alt="" width="320" height="320" />
      <p class="eyebrow">Uniquefacturing</p>
      <h1>An R&amp;D partner that raises your technical edge</h1>
      <p class="lead">Prototype Studio</p>
      <a href="#contact" class="btn">Start a project</a>
    </div>
  </section>

  <section id="about" class="section">
    <div class="container narrow">
      <h2>About</h2>
      <p>Uniquefacturing turns concepts into real things. We take responsibility from planning through completion, working alongside you.</p>
    </div>
  </section>

  <section id="contact" class="section section-alt">
    <div class="container narrow">
      <h2>Contact</h2>
      <p class="contact-email"><a href="mailto:uni@ufac.dev">uni@ufac.dev</a></p>
    </div>
  </section>
</BaseLayout>
