---
import { t, prefix, altPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const p = prefix(lang);
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const switchHref = altPath(Astro.url.pathname, other);
---

<header class="site-header">
  <div class="container">
    <a href={`${p}/`} class="logo" aria-label={s.home_label}>
      <img
        src="/images/uniquefacturing-high-resolution-logo-color-on-transparent-background.png"
        alt="Uniquefacturing"
        width="2000"
        height="252"
      />
    </a>
    <button class="nav-toggle" aria-label={s.menu_open} aria-expanded="false">☰</button>
    <nav class="site-nav">
      <a href={`${p}/#about`}>{s.nav_about}</a>
      <a href={`${p}/blog/`}>{s.nav_blog}</a>
      <a href={`${p}/#contact`}>{s.nav_contact}</a>
      <a href={switchHref} class="lang-switch" lang={other} hreflang={other}>{s.switch_label}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('.site-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
