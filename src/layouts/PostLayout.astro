---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { t, prefix, formatDate, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const s = t(lang);
const p = prefix(lang);
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout lang={lang} title={`${title} | UFAC`} description={description}>
  <article class="section">
    <div class="container narrow">
      <a href={`${p}/blog/`} class="back-link">{s.back_to_list}</a>
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
          {updatedDate && (
            <span>({s.updated}: {formatDate(updatedDate, lang)})</span>
          )}
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
